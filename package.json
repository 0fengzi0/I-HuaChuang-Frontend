{
  "name": "ihuachuang-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "I画创 AI 图片创作工作台前端与 GitHub Pages 站点",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:pages": "vue-tsc -b && vite build --mode pages && node scripts/prepare-pages.mjs",
    "preview": "vite preview",
    "preview:pages": "vite preview --mode pages",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.104.5",
    "@vee-validate/zod": "^4.15.1",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^4.1.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
